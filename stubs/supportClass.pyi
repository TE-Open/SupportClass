import dataclasses
from typing import Any

class ConfigMem:
    @dataclasses.dataclass
    class ConfigItem:
        name: str
        isList: bool
        type: type
        isValidClass: bool
        initArgCount: int
        value: Any
    dirPath: str
    hasFile: bool
    baseFileName: str
    name: str
    version: str
    owner: object
    autoSync: bool
    versionRequired: bool
    itemDict: dict
    def __init__(self, name: str, configItems: tuple[tuple[str, bool, type, Any], ...], owner: object, configDir: str, configFile: str = '', autoSync: bool = False, versionRequired: bool = True) -> None: ...
    def load(self, version: str | int = '') -> bool: ...
    def save(self, version: str | int = ''): ...
    def getSaveFileName(self, version: str | int = '') -> str: ...
    def get(self, itemName: str): ...
    def set(self, itemName: str, newVal: Any): ...
    def loadDefault(self) -> None: ...
    def saveDefault(self) -> None: ...
    def show(self, mustPrint: bool = False): ...

class DoBase:
    def __init__(self) -> None: ...
    def do(self, cmd=None): ...
